    ("[D'ag'U]", "[D'AG'U]"),
    ("[FEU]", "[FEU]"),
    ("[ELU]", "[ELU]"),
    ("[EU]", "[EU]"),
    ("Np", "NEP"),
    ("B", "B"),
    ("B[SPL]", "B[SPL]"),
    ("B[V]", "B[V]"),
    ("B[mV]", "B[MV]"),
    ("B[uV]", "B[UV]"),
    ("B[10.nV]", "B[10.NV]"),
    ("B[W]", "B[W]"),
    ("B[kW]", "B[KW]"),
    ("st", "STR"),
    ("Ao", "AO"),
    ("b", "BRN"),
    ("att", "ATT"),
    ("mho", "MHO"),
    ("[psi]", "[PSI]"),
    ("circ", "CIRC"),
    ("sph", "SPH"),
    ("[car_m]", "[CAR_M]"),
    ("[car_Au]", "[CAR_AU]"),
    ("[smoot]", "[SMOOT]"),
    ("[m/s2/Hz^(1/2)]", "[M/S2/HZ^(1/2)]"),
    ("[NTU]", "[NTU]"),
    ("[FNU]", "[FNU]"),
    ("bit_s", "BIT_S"),
    ("bit", "BIT"),
    ("By", "BY"),
    ("Bd", "BD"),
  ]
  for (canonical, single) in cases {
    ci.validate(single)
    ci.validate(single.to_upper())
    ci.validate(single.to_lower())
    let baseline = Some(cs.normalize(canonical)) catch {
      @ucum.Unsupported(_) => None
      error => raise error
    }
    if baseline is Some(baseline) {
      let actual = ci.normalize(single)
      assert_eq(actual.exponents(), baseline.exponents(), msg=canonical)
      assert_true(
        actual
        .factor()
        .is_close(
          baseline.factor(),
          relative_tolerance=1.0e-12,
          absolute_tolerance=0.0,
        ),
        msg=canonical,
      )
      assert_eq(actual.origin(), baseline.origin(), msg=canonical)
    }
  }
}

///|
test "all case-insensitive prefixes use the standard prefix factors" {
  let ci = @ucum.Engine::new(mode=@ucum.CaseInsensitive)
  let cases : Array[(String, Double)] = [
    ("YAM", 1.0e+24),
    ("ZAM", 1.0e+21),
    ("EXM", 1.0e+18),
    ("PTM", 1000000000000000.0),
    ("TRM", 1000000000000.0),
    ("GAM", 1000000000.0),
    ("MAM", 1000000.0),
    ("KM", 1000.0),
    ("HM", 100.0),
    ("DAM", 10.0),
    ("DM", 0.1),
    ("CM", 0.01),
    ("MM", 0.001),
    ("UM", 1.0e-06),
    ("NM", 1.0e-09),
    ("PM", 1.0e-12),
    ("FM", 1.0e-15),
    ("AM", 1.0e-18),
    ("ZOM", 1.0e-21),
    ("YOM", 1.0e-24),
    ("KIBM", 1024.0),
    ("MIBM", 1048576.0),
    ("GIBM", 1073741824.0),
    ("TIBM", 1099511627776.0),
  ]
  for (code, factor) in cases {
    assert_true(
      ci
      .convert(1.0, code, "M")
      .is_close(factor, relative_tolerance=1.0e-12, absolute_tolerance=0.0),
      msg=code,
    )
  }
}

///|
test "all special atom functions preserve semantics in both code systems" {
  let cs = @ucum.Engine::new()
  let ci = @ucum.Engine::new(mode=@ucum.CaseInsensitive)
  let cases : Array[(String, String, String, String)] = [
    ("Cel", "CEL", "K", "K"),
    ("[degF]", "[DEGF]", "K/9", "K/9"),
    ("[degRe]", "[degRe]", "K/4", "K/4"),
    ("[p'diop]", "[P'DIOP]", "rad", "RAD"),
    ("%[slope]", "%[SLOPE]", "rad", "RAD"),
    ("[hp'_X]", "[HP'_X]", "1", "1"),
    ("[hp'_C]", "[HP'_C]", "1", "1"),
    ("[hp'_M]", "[HP'_M]", "1", "1"),
    ("[hp'_Q]", "[HP'_Q]", "1", "1"),
    ("[pH]", "[PH]", "mol/l", "MOL/L"),
    ("Np", "NEP", "1", "1"),
    ("B", "B", "1", "1"),
    ("B[SPL]", "B[SPL]", "10*-5.Pa", "10*-5.PAL"),
    ("B[V]", "B[V]", "V", "V"),
    ("B[mV]", "B[MV]", "mV", "MV"),
    ("B[uV]", "B[UV]", "uV", "UV"),
    ("B[10.nV]", "B[10.NV]", "nV", "NV"),
    ("B[W]", "B[W]", "W", "W"),
    ("B[kW]", "B[KW]", "kW", "KW"),
    ("[m/s2/Hz^(1/2)]", "[M/S2/HZ^(1/2)]", "m2/s4/Hz", "M2/S4/HZ"),
    ("bit_s", "BIT_S", "1", "1"),
  ]
  for (source, single, target, single_target) in cases {
    let expected = cs.convert(1.0, source, target)
    let actual = ci.convert(1.0, single, single_target)
    assert_true(
      actual.is_close(
        expected,
        relative_tolerance=1.0e-12,
        absolute_tolerance=0.0,
      ),
      msg=source,
    )
  }
}
